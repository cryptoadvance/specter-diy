			)
			(justify left)
		)
		(uuid "a4719e1d-119f-425c-80e3-c9287eadc36e")
	)
	(text "Just use a diode to prevent backfeed over USB, \npower waste here isn't an issue.\n\nUse a enhancment P-Fet as an ideal diode that\nlets current flow when PWR_VIN is lower than BATT_P.\n(Extra diode to deal with some transient situations where the fet is slightly too slow to respond)\n\nNo protection for LIPO over-discharge. (Use battery with BMS)"
		(exclude_from_sim no)
		(at 181.356 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac498bf9-b77b-4b9d-bb87-407292916cb2")
	)
	(text "Secondary \nForce-Off function\n(Long Press off)"
		(exclude_from_sim no)
		(at 270.51 137.922 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b7a0a6f8-ec67-477c-94c4-b1efa5255da9")
	)
	(text "Parallel 2 JLCPCB\nBasic Resistors\n(Rather than use extended)"
		(exclude_from_sim no)
