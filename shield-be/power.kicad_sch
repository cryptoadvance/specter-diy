	(text "Ilim = 1030000/Rlim\n(Switching current peak, not output current peak)"
		(exclude_from_sim no)
		(at 154.94 269.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0ab13bbd-e215-472a-9130-328dc8d6a41f")
	)
	(text "-=BATTERY LEVEL MEASUREMENT=-\nRead the battery voltage via ADC.\nDivider network to get voltage within ADC range.\nMOSFET to disconnect the battery when device is off."
		(exclude_from_sim no)
		(at 140.716 112.268 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ed78ad7-7d5d-4bc4-9a7c-df5b1d5cf3a9")
	)
	(text "This resistor bypasses\nall power button logic\nand just runs the\nswitchmode all the time\n(For non-battery varients)"
		(exclude_from_sim no)
		(at 312.42 113.538 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "25275f75-7602-43b5-b8ce-00ce5d1b0abb")
	)
	(text "-=Load Connect/Disconnect=-\nThe switchmode power supply will just\ndeliver vin=vout when not enabled (not 0)\n\nSo use an enhancement p-fet to disable output\nunless PWR_EN is enabled.\n\n(This should also minimise power use when off)"
		(exclude_from_sim no)
		(at 350.012 183.388 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5ebce4b2-d565-4c2c-8444-a760dcfc43a3")
	)
	(text "Vout = 1.2 * (1 + Rfbt/Rfbb)"
		(exclude_from_sim no)
		(at 211.074 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "701d3ec3-d673-4cbd-9a6f-2d1b07122678")
	)
	(text "-=BATTERY CHARGER=-\nStandard TP4056 design.\nAssumes 2 wire battery \nwith BMS to manage temperature."
		(exclude_from_sim no)
		(at 231.648 41.402 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8e795b3c-9cf2-4b9c-91fa-83dd9d30277c")
	)
	(text "-=Power Buttons=-"
		(exclude_from_sim no)
		(at 349.758 29.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "90cbad15-611e-4dbf-9b10-d6620d07bb5f")
	)
	(text "-=USBC INPUT=-\nStandard USB-C resistors to get 5v.\nTVS Diode for basic protection."
		(exclude_from_sim no)
		(at 83.312 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a200d66c-0fbb-4add-ad0f-491056d0e3df")
	)
	(text "-=BATTERY/USB POWER SELECTION=-\nJust use a diode to prevent backfeed over USB, \npower waste here isn't an issue.\n\nUse a enhancment P-Fet as an ideal diode that\nlets current flow when PWR_VIN is lower than BATT_P\n\nNo protection for LIPO over-discharge. (Use battery with BMS)"
		(exclude_from_sim no)
		(at 121.92 68.834 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac498bf9-b77b-4b9d-bb87-407292916cb2")
	)
	(text "Secondary Power button to \nForce-Off"
		(exclude_from_sim no)
		(at 309.626 142.748 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b7a0a6f8-ec67-477c-94c4-b1efa5255da9")
	)
	(text "Parallel 2 JLCPCB\nBasic Resistors\n(Rather than use extended)"
		(exclude_from_sim no)
		(at 237.49 86.614 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c1ab347d-882d-4163-aee5-25356c57241f")
	)
	(text "SpecterDIY drives PWR_HOLD2\nhigh immediately at boot.\n\nDrives it low to request power off."
		(exclude_from_sim no)
		(at 345.694 94.996 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d6737fe4-b064-444d-abcf-2244c6907463")
	)
	(text "-=Switchmode Power Supply=-\nA basic TPS61089 Design, straigh off the TI Reference tool.\n\nValues rounded to nearest \"JLCPCB\" basic part value."
		(exclude_from_sim no)
		(at 167.64 184.658 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e749f81a-b3eb-4c9e-b5be-aa59c37f55a3")
	)
	(text "Rprog Charge Current Setting\nRPROG(k-ohm) IBAT(mA)\n10		130\n5		250\n4		300\n3		400\n2		580\n1.66	690\n1.5		780\n1.33	900\n1.2 	1000\n\nSpecter + QR scanner can draw about ~600ma, \nso charge at 900ma to avoid overloading some USB-C ports that can only deliver 1.5a"
		(exclude_from_sim no)
		(at 173.482 85.344 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f167ad2b-2bdf-4871-a668-6601dac334b6")
	)
